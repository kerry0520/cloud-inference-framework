://api.github.com/users/yewentao256/repos","events_url":"https://api.github.com/users/yewentao256/events{/privacy}","received_events_url":"https://api.github.com/users/yewentao256/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"sfeng33","id":200688931,"node_id":"U_kgDOC_ZFIw","avatar_url":"https://avatars.githubusercontent.com/u/200688931?v=4","gravatar_id":"","url":"https://api.github.com/users/sfeng33","html_url":"https://github.com/sfeng33","followers_url":"https://api.github.com/users/sfeng33/followers","following_url":"https://api.github.com/users/sfeng33/following{/other_user}","gists_url":"https://api.github.com/users/sfeng33/gists{/gist_id}","starred_url":"https://api.github.com/users/sfeng33/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sfeng33/subscriptions","organizations_url":"https://api.github.com/users/sfeng33/orgs","repos_url":"https://api.github.com/users/sfeng33/repos","events_url":"https://api.github.com/users/sfeng33/events{/privacy}","received_events_url":"https://api.github.com/users/sfeng33/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":102,"created_at":"2025-10-23T19:38:03Z","updated_at":"2026-10-14T07:00:21Z","closed_at":null,"assignee":{"login":"yewentao256","id":44945378,"node_id":"MDQ6VXNlcjQ0OTQ1Mzc4","avatar_url":"https://avatars.githubusercontent.com/u/44945378?v=4","gravatar_id":"","url":"https://api.github.com/users/yewentao256","html_url":"https://github.com/yewentao256","followers_url":"https://api.github.com/users/yewentao256/followers","following_url":"https://api.github.com/users/yewentao256/following{/other_user}","gists_url":"https://api.github.com/users/yewentao256/gists{/gist_id}","starred_url":"https://api.github.com/users/yewentao256/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yewentao256/subscriptions","organizations_url":"https://api.github.com/users/yewentao256/orgs","repos_url":"https://api.github.com/users/yewentao256/repos","events_url":"https://api.github.com/users/yewentao256/events{/privacy}","received_events_url":"https://api.github.com/users/yewentao256/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## 🚀 The feature, motivation and pitch\n\nWe have basically support Batch Invariant based on https://thinkingmachines.ai/blog/defeating-nondeterminism-in-llm-inference/\n\nhttps://github.com/orgs/vllm-project/projects/29/views/1\n\nBut there are still some work to be done, so here is the issue to track the work\n\n## TODOs:\n\n- [x] Basic framework https://github.com/vllm-project/vllm/pull/25603 @bwasti \n- [x] Flashinfer support https://github.com/vllm-project/vllm/pull/26373 @bwasti \n- [x] Deepseek-v3 https://github.com/vllm-project/vllm/pull/26609 @bwasti \n- [x] DeepGEMM on Blackwell https://github.com/vllm-project/vllm/pull/27127  @yewentao256 \n- [x] Batch Invariant for R1 TP 8 on Blackwell https://github.com/vllm-project/vllm/pull/27229 @yewentao256 \n- [x] Torch compile & Cuda Graph support  https://github.com/vllm-project/vllm/pull/27660  @PaulZhang12 \n- [x] Usability & Documentation @bwasti  https://github.com/vllm-project/vllm/pull/27839\n- [x] an RL example @bwasti  https://github.com/bwasti/spirl\n- [x] Adds Batch invariant tests to CI https://github.com/vllm-project/vllm/pull/27842 @yewentao256 \n- [x] TRITON_MLA support https://github.com/vllm-project/vllm/pull/29125 @yewentao256 \n- [ ] FLASHINFER_MLA support 🙋Help needed, context: https://github.com/flashinfer-ai/flashinfer/issues/2107\n\n- [ ] Optimize the batch invariant performance\n    - [x] BMM optimization https://github.com/vllm-project/vllm/pull/29345 @yewentao256 \n    - [x] https://github.com/vllm-project/vllm/pull/39912 @jzakrzew \n    - [x] https://github.com/vllm-project/vllm/pull/40372 @jzakrzew \n    - [x] https://github.com/vllm-project/vllm/pull/40413 @yewentao256 \n    - [x] https://github.com/vllm-project/vllm/pull/40408 @yewentao256 \n    - [x] https://github.com/vllm-project/vllm/pull/53247 @LioEinaudi \n    - [x] https://github.com/vllm-project/vllm/pull/53649 @yewentao256 \n    - [ ]  🙋Help needed\n\n## Nice to have:\n\n- [ ] Prefix caching support\n- [ ] AMD support\n    - [ ] https://github.com/vllm-project/vllm/pull/52231 @mawong-amd \n- [ ] XPU support\n    - [x] https://github.com/vllm-project/vllm/pull/41934 @tzielinski-habana \n    - [ ] https://github.com/vllm-project/vllm/pull/49209 @tzielinski-habana\n- [ ] Speculative decoding support (this might be hard)\n    - [ ] https://github.com/vllm-project/vllm/pull/52522 @andakai \n- [x] (Out of scope) DP Support ~https://github.com/vllm-project/vllm/issues/30321~\n\n## Model coverage\n\nhttps://docs.vllm.ai/en/latest/features/batch_invariance/#tested-models\n\n🙋Help needed for validations of more models.\n\n1. Test a model using the script in https://github.com/vllm-project/vllm/tree/main/tests/v1/determinism\n2. Submit a PR updating the document","reactions":{"url":"https://api.github.com/repos/vllm-project/vllm/issues/27433/reactions","total_count":40,"+1":23,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":7,"rocket":1,"eyes":9},"timeline_url":"https://api.github.com/repos/vllm-project/vllm/issues/27433/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/vllm-project/vllm/issues/41230","repository_url":"https://api.github.com/repos/vllm-project/vllm","labels_url":"https://api.github.com/repos/vllm-project/vllm/issues/41230/labels{/name}","comments_url":"https://api.github.com/repos/vllm-project/vllm/issues/41230/comments","events_url":"https://api.github.com/repos/vllm-project/vllm/issues/41230/events","html_url":"https://github.com/vllm-project/vllm/issues/41230","id":4350583759,"node_id":"I_kwDOI7xefs8AAAABA1Cjzw","number":41230,"title":"[Docs] Document NIXL KV connector metrics aggregation semantics","user":{"login":"NickLucche","id":10706289,"node_id":"MDQ6VXNlcjEwNzA2Mjg5","avatar_url":"https://avatars.githubusercontent.com/u/10706289?v=4","gravatar_id":"","url":"https://api.github.com/users/NickLucche","html_url":"https://github.com/NickLucche","followers_url":"https://api.github.com/users/NickLucche/followers","following_url":"https://api.github.com/users/NickLucche/following{/other_user}","gists_url":"https://api.github.com/users/NickLucche/gists{/gist_id}","starred_url":"https://api.github.com/users/NickLucche/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/NickLucche/subscriptions","organizations_url":"https://api.github.com/users/NickLucche/orgs","repos_url":"https://api.github.com/users/NickLucche/repos","events_url":"https://api.github.com/users/NickLucche/events{/privacy}","received_events_url":"https://api.github.com/users/NickLucche/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":5135047198,"node_id":"LA_kwDOI7xefs8AAAABMhKaHg","url":"https://api.github.com/repos/vllm-project/vllm/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[{"login":"zeel2104","id":72783325,"node_id":"MDQ6VXNlcjcyNzgzMzI1","avatar_url":"https://avatars.githubusercontent.com/u/72783325?v=4","gravatar_id":"","url":"https://api.github.com/users/zeel2104","html_url":"https://github.com/zeel2104","followers_url":"https://api.github.com/users/zeel2104/followers","following_url":"https://api.github.com/users/zeel2104/following{/other_user}","gists_url":"https://api.github.com/users/zeel2104/gists{/gist_id}","starred_url":"https://api.github.com/users/zeel2104/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zeel2104/subscriptions","organizations_url":"https://api.github.com/users/zeel2104/orgs","repos_url":"https://api.github.com/users/zeel2104/repos","events_url":"https://api.github.com/users/zeel2104/events{/privacy}","received_events_url":"https://api.github.com/users/zeel2104/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":20,"created_at":"2026-04-29T12:38:34Z","updated_at":"2026-10-14T03:44:06Z","closed_at":null,"assignee":{"login":"zeel2104","id":72783325,"node_id":"MDQ6VXNlcjcyNzgzMzI1","avatar_url":"https://avatars.githubusercontent.com/u/72783325?v=4","gravatar_id":"","url":"https://api.github.com/users/zeel2104","html_url":"https://github.com/zeel2104","followers_url":"https://api.github.com/users/zeel2104/followers","following_url":"https://api.github.com/users/zeel2104/following{/other_user}","gists_url":"https://api.github.com/users/zeel2104/gists{/gist_id}","starred_url":"https://api.github.com/users/zeel2104/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zeel2104/subscriptions","organizations_url":"https://api.github.com/users/zeel2104/orgs","repos_url":"https://api.github.com/users/zeel2104/repos","events_url":"https://api.github.com/users/zeel2104/events{/privacy}","received_events_url":"https://api.github.com/users/zeel2104/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Summary\n\nThe NIXL KV connector logs transfer metrics periodically:\n\n```\nKV Transfer metrics: Num successful transfers=4, Avg xfer time (ms)=1.381, P90 xfer time (ms)=2.601, Avg post time (ms)=0.672, P90 post time (ms)=0.801, Avg MB per transfer=2.25, Throughput (MB/s)=1629.549, Avg number of descriptors=72.0\n```\n\nCurrently there is no documentation explaining what these metrics represent, especially in the context of **multi-rank (TP > 1) deployments**. This has already caused confusion among users.\n\n## Current behavior\n\nAll metrics are **aggregated across all TP ranks** before summary stats are computed:\n\n1. Each TP rank independently records per-transfer telemetry (`transfer_duration`, `post_duration`, `bytes_transferred`, `num_descriptors`) via `NixlKVConnectorStats.record_transfer()` in [`stats.py`](https://github.com/vllm-project/vllm/blob/main/vllm/distributed/kv_transfer/kv_connector/v1/nixl/stats.py).\n2. Stats from all ranks are concatenated via `aggregate()` (`list.extend()`).\n3. `reduce()` computes averages, percentiles, and throughput over the **combined** pool of observations from all ranks.\n\nThis means:\n- **\"Num successful transfers\"** is the total count across all ranks, not per-rank.\n- **\"Avg MB per transfer\"** is the average over all individual rank-level transfers, not the total bytes moved for a single KV cache transfer operation.\n- **\"Throughput (MB/s)\"** is `total_MB_all_ranks / total_time_all_ranks` — effectively an average per-rank throughput, not the aggregate system throughput.\n- **Percentiles (P90)** are computed over the combined distribution of all ranks' transfer times.\n\nThis is unintuitive because users may expect metrics to reflect per-engine totals or aggregate system throughput.\n\n## What needs to be documented\n\n1. **Docstrings in `stats.py`**: Add clear documentation to `NixlKVConnectorStats` explaining that stats are aggregated across all TP ranks and what each metric represents in that context.\n2. **Inline comments in `reduce()`**: Clarify the semantics of throughput and averages — that they are per-rank averages over the combined observation pool.\n3. **Docstrings in `metrics.py`**: Document the `observe()` → `aggregate()` → `reduce()` → `log()` pipeline and the fact that stats arrive pre-aggregated across workers.\n4. **(Optional) Docs page**: Add a section to the disaggregated serving documentation explaining how to interpret the KV Transfer metrics log line.\n\n## Relevant files\n\n- `vllm/distributed/kv_transfer/kv_connector/v1/nixl/stats.py` — `NixlKVConnectorStats` (recording, aggregation, reduction)\n- `vllm/distributed/kv_transfer/kv_connector/v1/metrics.py` — `KVConnectorLogging` (observe/log pipeline), `KVConnectorStats` (base class)\n\n## Context\n\nSee related discussion: metrics are aggregated across ranks rather than reported per-rank or per-engine. This is a deliberate design choice (fire-and-forget from workers), but it needs to be clearly documented so users can correctly interpret the numbers.","reactions":{"url":"https://api.github.com/repos/vllm-project/vllm/issues/41230/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vllm-project/vllm/issues/41230/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/vllm-project/vllm/issues/32588","repository_url":"https://api.github.com/repos/vllm-project/vllm","labels_url":"https://api.github.com/repos/vllm-project/vllm/issues/32588/labels{/name}","comments_url":"https://api.github.com/repos/vllm-project/vllm/issues/32588/comments","events_url":"https://api.github.com/repos/vllm-project/vllm/issues/32588/events","html_url":"https://github.com/vllm-project/vllm/issues/32588","id":3829035736,"node_id":"I_kwDOI7xefs7kOnLY","number":32588,"title":"[Bug]: Wrong timestamps if audio > 30s","user":{"login":"dr75","id":5467316,"node_id":"MDQ6VXNlcjU0NjczMTY=","avatar_url":"https://avatars.githubusercontent.com/u/5467316?v=4","gravatar_id":"","url":"https://api.github.com/users/dr75","html_url":"https://github.com/dr75","followers_url":"https://api.github.com/users/dr75/followers","following_url":"https://api.github.com/users/dr75/following{/other_user}","gists_url":"https://api.github.com/users/dr75/gists{/gist_id}","starred_url":"https://api.github.com/users/dr75/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dr75/subscriptions","organizations_url":"https://api.github.com/users/dr75/orgs","repos_url":"https://api.github.com/users/dr75/repos","events_url":"https://api.github.com/users/dr75/events{/privacy}","received_events_url":"https://api.github.com/users/dr75/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":5135047172,"node_id":"LA_kwDOI7xefs8AAAABMhKaBA","url":"https://api.github.com/repos/vllm-project/vllm/labels/bug","name":"bug","color":"d73a4a","default":true,"description":"Something isn't working","archived_at":null,"archived_by":null},{"id":5135047193,"node_id":"LA_kwDOI7xefs8AAAABMhKaGQ","url":"https://api.github.com/repos/vllm-project/vllm/labels/help%20wanted","name":"help wanted","color":"008672","default":true,"description":"Extra attention is needed","archived_at":null,"archived_by":null},{"id":5135047198,"node_id":"LA_kwDOI7xefs8AAAABMhKaHg","url":"https://api.github.com/repos/vllm-project/vllm/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers","archived_at":null,"archived_by":null},{"id":7652610994,"node_id":"LA_kwDOI7xefs8AAAAByCGTsg","url":"https://api.github.com/repos/vllm-project/vllm/labels/unstale","name":"unstale","color":"fef2c0","default":false,"description":"Recieved activity after being labelled stale","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[{"login":"dr75","id":5467316,"node_id":"MDQ6VXNlcjU0NjczMTY=","avatar_url":"https://avatars.githubusercontent.com/u/5467316?v=4","gravatar_id":"","url":"https://api.github.com/users/dr75","html_url":"https://github.com/dr75","followers_url":"https://api.github.com/users/dr75/followers","following_url":"https://api.github.com/users/dr75/following{/other_user}","gists_url":"https://api.github.com/users/dr75/gists{/gist_id}","starred_url":"https://api.github.com/users/dr75/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dr75/subscriptions","organizations_url":"https://api.github.com/users/dr75/orgs","repos_url":"https://api.github.com/users/dr75/repos","events_url":"https://api.github.com/users/dr75/events{/privacy}","received_events_url":"https://api.github.com/users/dr75/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"aadeshupadhyay","id":220231336,"node_id":"U_kgDODSB2qA","avatar_url":"https://avatars.githubusercontent.com/u/220231336?v=4","gravatar_id":"","url":"https://api.github.com/users/aadeshupadhyay","html_url":"https://github.com/aadeshupadhyay","followers_url":"https://api.github.com/users/aadeshupadhyay/followers","following_url":"https://api.github.com/users/aadeshupadhyay/following{/other_user}","gists_url":"https://api.github.com/users/aadeshupadhyay/gists{/gist_id}","starred_url":"https://api.github.com/users/aadeshupadhyay/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aadeshupadhyay/subscriptions","organizations_url":"https://api.github.com/users/aadeshupadhyay/orgs","repos_url":"https://api.github.com/users/aadeshupadhyay/repos","events_url":"https://api.github.com/users/aadeshupadhyay/events{/privacy}","received_events_url":"https://api.github.com/users/aadeshupadhyay/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":17,"created_at":"2026-01-19T10:27:12Z","updated_at":"2026-10-13T20:31:24Z","closed_at":null,"assignee":{"login":"dr75","id":5467316,"node_id":"MDQ6VXNlcjU0NjczMTY=","avatar_url":"https://avatars.githubusercontent.com/u/5467316?v=4","gravatar_id":"","url":"https://api.github.com/users/dr75","html_url":"https://github.com/dr75","followers_url":"https://api.github.com/users/dr75/followers","following_url":"https://api.github.com/users/dr75/following{/other_user}","gists_url":"https://api.github.com/users/dr75/gists{/gist_id}","starred_url":"https://api.github.com/users/dr75/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dr75/subscriptions","organizations_url":"https://api.github.com/users/dr75/orgs","repos_url":"https://api.github.com/users/dr75/repos","events_url":"https://api.github.com/users/dr75/events{/privacy}","received_events_url":"https://api.github.com/users/dr75/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Your current environment\n\n\nNA\n\n### 🐛 Describe the bug\n\n**Segment level timestamps are incrementally offset by ~0.5s per segment.**\n\nWhen transcribing long audio with vLLM Whisper, segment-level timestamps are increasingly inaccurate. Chunking uses by default a 1s window to find low-energy (quiet) regions for splitting, so the next chunk may start up to 1s earlier than the nominal chunk length. This offset is not compensated for when generating segment timestamps, resulting in an average delay of ~0.5s per segment, which accumulates (e.g., 5s after 10 segments).\n\nClients can workaround by subtracting 0.5s per segment, but that's obviously not accurate.\n\nAlso, the [related documentation](https://github.com/vllm-project/vllm/blob/e83b7e379c11bf136c1b96bc6a67b6d2207cfde4/docs/contributing/model/transcription.md#audio-preprocessing-and-chunking) is not correct: there are no overlapping chunks, but just a window for searching the best split point. Maybe this confusion is the cause of the issue.\n\n### Before submitting a new issue...\n\n- [x] Make sure you already searched for relevant issues, and asked the chatbot living at the bottom right corner of the [documentation page](https://docs.vllm.ai/en/latest/), which can answer lots of frequently asked questions.","reactions":{"url":"https://api.github.com/repos/vllm-project/vllm/issues/32588/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vllm-project/vllm/issues/32588/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/vllm-project/vllm/issues/32335","repository_url":"https://api.github.com/repos/vllm-project/vllm","labels_url":"https://api.github.com/repos/vllm-project/vllm/issues/32335/labels{/name}","comments_url":"https://api.github.com/repos/vllm-project/vllm/issues/32335/comments","events_url":"https://api.github.com/repos/vllm-project/vllm/issues/32335/events","html_url":"https://github.com/vllm-project/vllm/issues/32335","id":3813438622,"node_id":"I_kwDOI7xefs7jTHSe","number":32335,"title":"[Feature]: Extract KV-Cache update from all attention backends","user":{"login":"ElizaWszola","id":26595727,"node_id":"MDQ6VXNlcjI2NTk1NzI3","avatar_url":"https://avatars.githubusercontent.com/u/26595727?v=4","gravatar_id":"","url":"https://api.github.com/users/ElizaWszola","html_url":"https://github.com/ElizaWszola","followers_url":"https://api.github.com/users/ElizaWszola/followers","following_url":"https://api.github.com/users/ElizaWszola/following{/other_user}","gists_url":"https://api.github.com/users/ElizaWszola/gists{/gist_id}","starred_url":"https://api.github.com/users/ElizaWszola/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ElizaWszola/subscriptions","organizations_url":"https://api.github.com/users/ElizaWszola/orgs","repos_url":"https://api.github.com/users/ElizaWszola/repos","events_url":"https://api.github.com/users/ElizaWszola/e