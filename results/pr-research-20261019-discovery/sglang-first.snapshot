rivacy}","received_events_url":"https://api.github.com/users/ispobock/received_events","type":"User","user_view_type":"public","site_admin":false},{"login":"zhyncs","id":46627482,"node_id":"MDQ6VXNlcjQ2NjI3NDgy","avatar_url":"https://avatars.githubusercontent.com/u/46627482?v=4","gravatar_id":"","url":"https://api.github.com/users/zhyncs","html_url":"https://github.com/zhyncs","followers_url":"https://api.github.com/users/zhyncs/followers","following_url":"https://api.github.com/users/zhyncs/following{/other_user}","gists_url":"https://api.github.com/users/zhyncs/gists{/gist_id}","starred_url":"https://api.github.com/users/zhyncs/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zhyncs/subscriptions","organizations_url":"https://api.github.com/users/zhyncs/orgs","repos_url":"https://api.github.com/users/zhyncs/repos","events_url":"https://api.github.com/users/zhyncs/events{/privacy}","received_events_url":"https://api.github.com/users/zhyncs/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":5,"created_at":"2024-11-30T06:36:16Z","updated_at":"2026-09-21T22:43:28Z","closed_at":null,"assignee":{"login":"ispobock","id":26454835,"node_id":"MDQ6VXNlcjI2NDU0ODM1","avatar_url":"https://avatars.githubusercontent.com/u/26454835?v=4","gravatar_id":"","url":"https://api.github.com/users/ispobock","html_url":"https://github.com/ispobock","followers_url":"https://api.github.com/users/ispobock/followers","following_url":"https://api.github.com/users/ispobock/following{/other_user}","gists_url":"https://api.github.com/users/ispobock/gists{/gist_id}","starred_url":"https://api.github.com/users/ispobock/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ispobock/subscriptions","organizations_url":"https://api.github.com/users/ispobock/orgs","repos_url":"https://api.github.com/users/ispobock/repos","events_url":"https://api.github.com/users/ispobock/events{/privacy}","received_events_url":"https://api.github.com/users/ispobock/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"cuDNN provides very fast attention implementation and it is well maintained by NVIDIA. We would like to add a new attention backend based on cudnn.  \r\n\r\n## Steps\r\n1. Learn this cudnn paged attention python api. https://github.com/NVIDIA/cudnn-frontend/blob/v1.8.0/samples/python/52_scaled_dot_product_attention_with_paged_caches.ipynb\r\n2. Add a new attention backend \"cudnn\" here https://github.com/sgl-project/sglang/tree/main/python/sglang/srt/layers/attention\r\n3. We should be able to use it with `python3 -m sglang.launch_server --model meta-llama/Llama-3.1-8B-Instruct --attention-backend cudnn`","reactions":{"url":"https://api.github.com/repos/sgl-project/sglang/issues/2272/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sgl-project/sglang/issues/2272/timeline","performed_via_github_app":null,"state_reason":"reopened","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/sgl-project/sglang/issues/6357","repository_url":"https://api.github.com/repos/sgl-project/sglang","labels_url":"https://api.github.com/repos/sgl-project/sglang/issues/6357/labels{/name}","comments_url":"https://api.github.com/repos/sgl-project/sglang/issues/6357/comments","events_url":"https://api.github.com/repos/sgl-project/sglang/issues/6357/events","html_url":"https://github.com/sgl-project/sglang/issues/6357","id":3069912992,"node_id":"I_kwDOLCAjRs62-yeg","number":6357,"title":"[Bug] The Prometheus metric `avg_request_queue_latency` is not being collected","user":{"login":"jorgeantonio21","id":17906522,"node_id":"MDQ6VXNlcjE3OTA2NTIy","avatar_url":"https://avatars.githubusercontent.com/u/17906522?v=4","gravatar_id":"","url":"https://api.github.com/users/jorgeantonio21","html_url":"https://github.com/jorgeantonio21","followers_url":"https://api.github.com/users/jorgeantonio21/followers","following_url":"https://api.github.com/users/jorgeantonio21/following{/other_user}","gists_url":"https://api.github.com/users/jorgeantonio21/gists{/gist_id}","starred_url":"https://api.github.com/users/jorgeantonio21/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jorgeantonio21/subscriptions","organizations_url":"https://api.github.com/users/jorgeantonio21/orgs","repos_url":"https://api.github.com/users/jorgeantonio21/repos","events_url":"https://api.github.com/users/jorgeantonio21/events{/privacy}","received_events_url":"https://api.github.com/users/jorgeantonio21/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":6403845287,"node_id":"LA_kwDOLCAjRs8AAAABfbLspw","url":"https://api.github.com/repos/sgl-project/sglang/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":6,"created_at":"2025-05-16T21:20:37Z","updated_at":"2026-09-13T07:27:02Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Checklist\n\n- [x] 1. I have searched related issues but cannot get the expected help.\n- [x] 2. The bug has not been fixed in the latest version.\n- [ ] 3. Please note that if the bug-related issue you submitted lacks corresponding environment info and a minimal reproducible demo, it will be challenging for us to reproduce and resolve the issue, reducing the likelihood of receiving feedback.\n- [ ] 4. If the issue you raised is not a bug but a question, please raise a discussion at https://github.com/sgl-project/sglang/discussions/new/choose Otherwise, it will be closed.\n- [x] 5. Please use English, otherwise it will be closed.\n\n### Describe the bug\n\nI have integrate Sglang metrics with Grafana dashboards, and the metric `avg_request_queue_latency` is not currently available, while all the other metrics are being collected. \n\nThe `avg_request_queue_latency` is of importance for understanding the behavior of the system in high load situations.\n\n### Reproduction\n\nYou can query Prometheus metrics at http://localhost:3000/metrics\n\n### Environment\n\nI have deployed using docker compose:\n\n```yaml\nsglang:\n    container_name: sglang\n    profiles: [chat_completions_sglang]\n    image: lmsysorg/sglang:latest\n    volumes:\n      - ${HOME}/.cache/huggingface:/root/.cache/huggingface\n    restart: always\n    network_mode: host # required by RDMA\n    privileged: true # required by RDMA\n    environment:\n      HF_TOKEN: ${HF_TOKEN}\n    entrypoint: python3 -m sglang.launch_server\n    command:\n      --model-path ${SGLANG_MODEL_PATH} --tp 8 --enable-dp-attention --dp 8 --trust-remote-code --max-running-requests 128 --enable-metrics\n      --host 0.0.0.0\n      --port 3000\n    ulimits:\n      memlock: -1\n      stack: 67108864\n    ipc: host\n    healthcheck:\n      test: [\"CMD-SHELL\", \"curl -f http://localhost:3000/health || exit 1\"]\n    deploy:\n      resources:\n        reservations:\n          devices:\n            - driver: nvidia\n              device_ids: [\"0\"]\n              capabilities: [gpu]\n```","reactions":{"url":"https://api.github.com/repos/sgl-project/sglang/issues/6357/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sgl-project/sglang/issues/6357/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/sgl-project/sglang/issues/13809","repository_url":"https://api.github.com/repos/sgl-project/sglang","labels_url":"https://api.github.com/repos/sgl-project/sglang/issues/13809/labels{/name}","comments_url":"https://api.github.com/repos/sgl-project/sglang/issues/13809/comments","events_url":"https://api.github.com/repos/sgl-project/sglang/issues/13809/events","html_url":"https://github.com/sgl-project/sglang/issues/13809","id":3656260539,"node_id":"I_kwDOLCAjRs7Z7hu7","number":13809,"title":"[Feature] Reduce constrained-decoding overhead in TP","user":{"login":"DarkSharpness","id":76582120,"node_id":"MDQ6VXNlcjc2NTgyMTIw","avatar_url":"https://avatars.githubusercontent.com/u/76582120?v=4","gravatar_id":"","url":"https://api.github.com/users/DarkSharpness","html_url":"https://github.com/DarkSharpness","followers_url":"https://api.github.com/users/DarkSharpness/followers","following_url":"https://api.github.com/users/DarkSharpness/following{/other_user}","gists_url":"https://api.github.com/users/DarkSharpness/gists{/gist_id}","starred_url":"https://api.github.com/users/DarkSharpness/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DarkSharpness/subscriptions","organizations_url":"https://api.github.com/users/DarkSharpness/orgs","repos_url":"https://api.github.com/users/DarkSharpness/repos","events_url":"https://api.github.com/users/DarkSharpness/events{/privacy}","received_events_url":"https://api.github.com/users/DarkSharpness/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":6403845287,"node_id":"LA_kwDOLCAjRs8AAAABfbLspw","url":"https://api.github.com/repos/sgl-project/sglang/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[{"login":"raayandhar","id":58057652,"node_id":"MDQ6VXNlcjU4MDU3NjUy","avatar_url":"https://avatars.githubusercontent.com/u/58057652?v=4","gravatar_id":"","url":"https://api.github.com/users/raayandhar","html_url":"https://github.com/raayandhar","followers_url":"https://api.github.com/users/raayandhar/followers","following_url":"https://api.github.com/users/raayandhar/following{/other_user}","gists_url":"https://api.github.com/users/raayandhar/gists{/gist_id}","starred_url":"https://api.github.com/users/raayandhar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/raayandhar/subscriptions","organizations_url":"https://api.github.com/users/raayandhar/orgs","repos_url":"https://api.github.com/users/raayandhar/repos","events_url":"https://api.github.com/users/raayandhar/events{/privacy}","received_events_url":"https://api.github.com/users/raayandhar/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":4,"created_at":"2025-11-23T17:25:23Z","updated_at":"2026-09-11T08:00:11Z","closed_at":null,"assignee":{"login":"raayandhar","id":58057652,"node_id":"MDQ6VXNlcjU4MDU3NjUy","avatar_url":"https://avatars.githubusercontent.com/u/58057652?v=4","gravatar_id":"","url":"https://api.github.com/users/raayandhar","html_url":"https://github.com/raayandhar","followers_url":"https://api.github.com/users/raayandhar/followers","following_url":"https://api.github.com/users/raayandhar/following{/other_user}","gists_url":"https://api.github.com/users/raayandhar/gists{/gist_id}","starred_url":"https://api.github.com/users/raayandhar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/raayandhar/subscriptions","organizations_url":"https://api.github.com/users/raayandhar/orgs","repos_url":"https://api.github.com/users/raayandhar/repos","events_url":"https://api.github.com/users/raayandhar/events{/privacy}","received_events_url":"https://api.github.com/users/raayandhar/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"COLLABORATOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### Checklist\n\n- [x] If this is not a feature request but a general question, please start a discussion at https://github.com/sgl-project/sglang/discussions. Otherwise, it will be closed.\n- [x] Please use English. Otherwise, it will be closed.\n\n### Motivation\n\nCurrently, when tensor-parallelism (TP) and constrained-decoding are enabled, each TP worker will compile the same grammar across different TP ranks. This will incur non-trivial CPU overhead (for TP $n$, the overhead is $n \\times$. In fact, we only need to compile the grammar and sample the result on the first rank.\n\nA possible implementation can be:\n\n1. Only apply grammar token mask on the rank 0.\n2. Broadcast the next tokens id from rank 0 when there're grammars in batch.\n3. Keep the old code path when there's no grammar in batch (i.e. no extra all-reduce).\n\nhttps://github.com/sgl-project/sglang/blob/5c2915494c83f076a11afb2c3382eeb8a41f1974/python/sglang/srt/layers/sampler.py#L205-L217\n\n\n### Related resources\n\n_No response_","reactions":{"url":"https://api.github.com/repos/sgl-project/sglang/issues/13809/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/sgl-project/sglang/issues/13809/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/sgl-project/sglang/issues/27214","repository_url":"https://api.github.com/repos/sgl-project/sglang","labels_url":"https://api.github.com/repos/sgl-project/sglang/issues/27214/labels{/name}","comments_url":"https://api.github.com/repos/sgl-project/sglang/issues/27214/comments","events_url":"https://api.github.com/repos/sgl-project/sglang/issues/27214/events","html_url":"https://github.com/sgl-project/sglang/issues/27214","id":4585713041,"node_id":"I_kwDOLCAjRs8AAAABEVRtkQ","number":27214,"title":"model: support new diffusion models","user":{"login":"mickqian","id":30898949,"node_id":"MDQ6VXNlcjMwODk4OTQ5","avatar_url":"https://avatars.githubusercontent.com/u/30898949?v=4","gravatar_id":"","url":"https://api.github.com/users/mickqian","html_url":"https://github.com/mickqian","followers_url":"https://api.github.com/users/mickqian/followers","following_url":"https://api.github.com/users/mickqian/following{/other_user}","gists_url":"https://api.github.com/users/mickqian/gists{/gist_id}","starred_url":"https://api.github.com/users/mickqian/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mickqian/subscriptions","organizations_url":"https://api.github.com/users/mickqian/orgs","repos_url":"https://api.github.com/users/mickqian/repos","events_url":"https://api.github.com/users/mickqian/events{/privacy}","received_events_url":"https://api.github.com/users/mickqian/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":6403845287,"node_id":"LA_kwDOLCAjRs8AAAABfbLspw","url":"https://api.github.com/repos/sgl-project/sglang/labels/good%20first%20issue","name":"good first issue","color":"7057ff","default":true,"description":"Good for newcomers","archived_at":null,"archived_by":null},{"id":6403845292,"node_id":"LA_kwDOLCAjRs8AAAABfbLsrA","url":"https://api.github.com/repos/sgl-project/sglang/labels/help%20wanted","name":"help wanted","color":"008672","default":true,"description":"Extra attention is needed","archived_at":null,"archived_by":null},{"id":8056081086,"node_id":"LA_kwDOLCAjRs8AAAAB4C4Kvg","url":"https://api.github.com/repos/sgl-project/sglang/labels/Multi-modal","name":"Multi-modal","color":"ACF3B5","defa