5.1.6\n[pip3] nvidia-curand==10.4.0.35\n[pip3] nvidia-cusolver==12.0.4.66\n[pip3] nvidia-cusparse==12.6.3.3\n[pip3] nvidia-cusparselt-cu13==0.8.0\n[pip3] nvidia-cutlass-dsl==4.5.2\n[pip3] nvidia-cutlass-dsl-libs-base==4.5.2\n[pip3] nvidia-cutlass-dsl-libs-cu13==4.5.2\n[pip3] nvidia-ml-py==13.610.43\n[pip3] nvidia-nccl-cu13==2.28.9\n[pip3] nvidia-nvjitlink==13.0.88\n[pip3] nvidia-nvshmem-cu13==3.4.5\n[pip3] nvidia-nvtx==13.0.85\n[pip3] nvidia-nvvm==13.3.73\n[pip3] pyzmq==27.1.0\n[pip3] tokenspeed-triton==3.7.10.post20260531\n[pip3] torch==2.11.0+cu130\n[pip3] torch_c_dlpack_ext==0.1.5\n[pip3] torchaudio==2.11.0+cu130\n[pip3] torchvision==0.26.0+cu130\n[pip3] transformers==5.13.0\n[pip3] triton==3.6.0\n[conda] Could not collect\n\n==============================\n         vLLM Info\n==============================\nROCM Version                 : Could not collect\nvLLM Version                 : 0.25.1.dev24+g96bb89286.d20260710 (git sha: 96bb89286, date: 20260710)\nvLLM Build Flags:\n  CUDA Archs: 12.1a; ROCm: Disabled; XPU: Disabled\nGPU Topology:\n        GPU0    CPU Affinity    NUMA Affinity   GPU NUMA ID\nGPU0     X      0-19    0               N/A\n\nLegend:\n\n  X    = Self\n  SYS  = Connection traversing PCIe as well as the SMP interconnect between NUMA nodes (e.g., QPI/UPI)\n  NODE = Connection traversing PCIe as well as the interconnect between PCIe Host Bridges within a NUMA node\n  PHB  = Connection traversing PCIe as well as a PCIe Host Bridge (typically the CPU)\n  PXB  = Connection traversing multiple PCIe bridges (without traversing the PCIe Host Bridge)\n  PIX  = Connection traversing at most a single PCIe bridge\n  NV#  = Connection traversing a bonded set of # NVLinks\n\n==============================\n     Environment Variables\n==============================\nVLLM_NO_USAGE_STATS=1\nPYTORCH_ALLOC_CONF=expandable_segments:True\nVLLM_MARLIN_USE_ATOMIC_ADD=1\nNVIDIA_REQUIRE_CUDA=cuda>=13.0 brand=unknown,driver>=535,driver<536 brand=grid,driver>=535,driver<536 brand=tesla,driver>=535,driver<536 brand=nvidia,driver>=535,driver<536 brand=quadro,driver>=535,driver<536 brand=quadrortx,driver>=535,driver<536 brand=nvidiartx,driver>=535,driver<536 brand=vapps,driver>=535,driver<536 brand=vpc,driver>=535,driver<536 brand=vcs,driver>=535,driver<536 brand=vws,driver>=535,driver<536 brand=cloudgaming,driver>=535,driver<536 brand=unknown,driver>=550,driver<551 brand=grid,driver>=550,driver<551 brand=tesla,driver>=550,driver<551 brand=nvidia,driver>=550,driver<551 brand=quadro,driver>=550,driver<551 brand=quadrortx,driver>=550,driver<551 brand=nvidiartx,driver>=550,driver<551 brand=vapps,driver>=550,driver<551 brand=vpc,driver>=550,driver<551 brand=vcs,driver>=550,driver<551 brand=vws,driver>=550,driver<551 brand=cloudgaming,driver>=550,driver<551 brand=unknown,driver>=565,driver<566 brand=grid,driver>=565,driver<566 brand=tesla,driver>=565,driver<566 brand=nvidia,driver>=565,driver<566 brand=quadro,driver>=565,driver<566 brand=quadrortx,driver>=565,driver<566 brand=nvidiartx,driver>=565,driver<566 brand=vapps,driver>=565,driver<566 brand=vpc,driver>=565,driver<566 brand=vcs,driver>=565,driver<566 brand=vws,driver>=565,driver<566 brand=cloudgaming,driver>=565,driver<566 brand=unknown,driver>=570,driver<571 brand=grid,driver>=570,driver<571 brand=tesla,driver>=570,driver<571 brand=nvidia,driver>=570,driver<571 brand=quadro,driver>=570,driver<571 brand=quadrortx,driver>=570,driver<571 brand=nvidiartx,driver>=570,driver<571 brand=vapps,driver>=570,driver<571 brand=vpc,driver>=570,driver<571 brand=vcs,driver>=570,driver<571 brand=vws,driver>=570,driver<571 brand=cloudgaming,driver>=570,driver<571 brand=unknown,driver>=575,driver<576 brand=grid,driver>=575,driver<576 brand=tesla,driver>=575,driver<576 brand=nvidia,driver>=575,driver<576 brand=quadro,driver>=575,driver<576 brand=quadrortx,driver>=575,driver<576 brand=nvidiartx,driver>=575,driver<576 brand=vapps,driver>=575,driver<576 brand=vpc,driver>=575,driver<576 brand=vcs,driver>=575,driver<576 brand=vws,driver>=575,driver<576 brand=cloudgaming,driver>=575,driver<576\nCUDA_VERSION=13.0.2\nLD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/local/cuda/lib64\nNVIDIA_VISIBLE_DEVICES=all\nNVIDIA_DRIVER_CAPABILITIES=compute,utility\nNCCL_VERSION=2.28.3-1\nNVIDIA_PRODUCT_NAME=CUDA\nMAX_JOBS=16\nTORCH_CUDA_ARCH_LIST=12.1a\nPYTORCH_NVML_BASED_CUDA_CHECK=1\nTORCHINDUCTOR_COMPILE_THREADS=1\nTORCHINDUCTOR_CACHE_DIR=/tmp/torchinductor_root\n\n</details>\n\n\n### 🐛 Describe the bug\n\nServing nvidia/Qwen3.6-35B-A3B-NVFP4 (resolved architecture: Qwen3_5MoeForConditionalGeneration, quantization=modelopt_mixed — mixed FP8 / NVFP4 / W4A16_NVFP4 / MXFP8 across different layers) with --moe-backend flashinfer_b12x results in dramatically higher measured \"peak activation\" memory during startup profiling than the same launch without that flag, cutting the resulting KV cache size roughly in half.\n\n--linear-backend was left at auto in both runs (not forced), so this is isolated to the MoE backend selection specifically, not the separate --linear-backend flashinfer_b12x issue reported elsewhere (see \"possibly related\" below — different symptom, different code path).\n\nCommands compared\n\nOnly this one flag differs between the two runs; everything else identical:\n\n# Run A — no explicit MoE backend override\nvllm serve nvidia/Qwen3.6-35B-A3B-NVFP4 \\\n  --served-model-name nemotron-super-120b \\\n  --max-model-len 131072 \\\n  --max-num-batched-tokens 65536 \\\n  --enable-chunked-prefill \\\n  --max-num-seqs 512 \\\n  --gpu-memory-utilization 0.8 \\\n  --kv-cache-dtype fp8 \\\n  --attention-backend flashinfer \\\n  --enable-prefix-caching \\\n  --block-size 64 \\\n  --trust-remote-code \\\n  --load-format fastsafetensors\n\n# Run B — adds only:\n  --moe-backend flashinfer_b12x\n\nSingle GPU (DGX Spark GB10, sm_121). tensor_parallel_size=1, pipeline_parallel_size=1.\n\nExpected behavior\n\nKV cache capacity should be roughly the same (modulo any legitimately-needed workspace) regardless of which correctness-equivalent MoE backend computes the NVFP4 expert GEMMs, since the MoE backend choice shouldn't materially change how much intermediate activation memory the model needs at a given --max-num-batched-tokens.\n\nActual behavior\n\nRun A (no --moe-backend override): GPU KV cache size ≈ 58.38 GiB (headline figure from our own testing; full corresponding breakdown log not yet captured — TODO, see note below).\n\nRun B (--moe-backend flashinfer_b12x):\n\n(EngineCore pid=266) INFO 07-19 10:16:40 [gpu_worker.py:891] Free memory on device (102.45/121.63 GiB) on startup. Desired GPU memory utilization is (0.8, 97.3 GiB). Actual usage is 20.38 GiB for weight, 46.61 GiB for peak activation, 1.94 GiB for non-torch memory, and 3.87 GiB for CUDAGraph memory. Replace gpu_memory_utilization config with `--kv-cache-memory=26153459303` (24.36 GiB) to fit into requested memory, or `--kv-cache-memory=31679637504` (29.5 GiB) to fully utilize gpu memory. Current kv cache memory in use is 25.59 GiB.\n(EngineCore pid=266) INFO 07-19 10:12:54 [kv_cache_utils.py:2168] GPU KV cache size: 2,412,484 tokens\n(EngineCore pid=266) INFO 07-19 10:12:54 [kv_cache_utils.py:2169] Maximum concurrency for 131,072 tokens per request: 18.41x\n\nWeight memory (20.38 GiB) and CUDAGraph memory (3.87 GiB) are consistent between both runs (same model, same graph capture sizes). The peak activation figure (46.61 GiB in Run B) is the only large moving part, and it directly drives the ~32 GiB difference in resulting KV cache capacity.\n\nRelevant context also visible in the Run B log: MoE backend selection confirms b12x is active —\n\n(EngineCore pid=266) INFO 07-19 10:04:36 [nvfp4.py:247] Using 'FLASHINFER_B12X' NvFp4 MoE backend out of potential backends: ['FLASHINFER_TRTLLM', 'FLASHINFER_CUTEDSL', 'FLASHINFER_CUTEDSL_BATCHED', 'FLASHINFER_CUTLASS', 'VLLM_CUTLASS', 'MARLIN', 'HUMMING', 'EMULATION'].\n\n— yet a separate warning also fires during weight loading:\n\n(EngineCore pid=266) WARNING 07-19 10:06:10 [marlin.py:34] Your GPU does not have native support for FP4 computation but FP4 quantization is being used. Weight-only FP4 compression will be used leveraging the Marlin kernel. This may degrade performance for compute-heavy workloads.\n\nsuggesting at least some NVFP4-quantized layers in this mixed-precision checkpoint fall back to Marlin regardless (plausibly ones b12x doesn't cover), while the MoE experts specifically go through b12x. Not sure if this is related to the memory difference or a separate, orthogonal observation — flagging it in case it's a useful clue.\n\nHypothesis (unconfirmed — flagging as a question, not a claim)\n\nPer the flashinfer_b12x_moe docs and the upstream [lukealonso/b12x](https://github.com/lukealonso/b12x) kernel library, this backend keeps hidden-state activations in BF16 and performs weight dequantization / activation quantization internally inside the fused kernel, rather than operating on a pre-quantized (smaller) activation representation throughout the token-dispatch/permutation pipeline. If the kernel's internal dispatch/scratch buffers are sized at BF16 precision, that would plausibly explain a large jump in measured peak activation relative to a backend that keeps intermediate MoE-routing buffers in a lower-precision format. This is an architectural inference from the public kernel description, not something we've verified against the kernel source directly — would appreciate confirmation or correction from someone closer to the b12x/FlashInfer integration.\n\nIf this is expected behavior, it would be very useful to have it called out explicitly in the --moe-backend flashinfer_b12x docs (the memory/throughput trade-off is significant enough — roughly half the KV cache in our case — that it changes the calculus for concurrency-heavy serving workloads), and/or to have the MoE workspace/scratch cost broken out as its own line in the memory-profiling log instead of folded into the generic \"peak activation\" bucket, so it's visible without having to diff two full startup logs to notice it.\n\nWhat we haven't yet tried\n\n\nFull startup log for Run A (no --moe-backend override) with the matching \"Actual usage is...\" breakdown line, for a fully apples-to-apples diff. Will attach if useful.\nWhether --max-num-batched-tokens scales the peak-activation gap (if the b12x scratch buffer is sized off this value, reducing it should shrink the gap — testing separately).\nWhether this reproduces on the SM100 (datacenter Blackwell / B200) b12x-adjacent path, or is specific to the SM12x consumer-tier kernel variant.\n\n\nPossibly related\n\n\n#47365 — same model, same mixed NVFP4/FP8 hybrid-GDN checkpoint, --moe-backend flashinfer_b12x, but a correctness bug (garbage output under TP=2/PP=2), not a memory-footprint issue. Unrelated code path but same feature area.\nPR #40082 (original b12x integration) and the lukealonso/b12x upstream repo, for the BF16-activation architecture detail referenced above.\n\n\nBefore submitting a new issue...\n\n\n Searched existing and past issues; found related correctness bugs (#47365) but nothing describing this memory/KV-cache effect specifically.\n\n### Before submitting a new issue...\n\n- [x] Make sure you already searched for relevant issues, and asked the chatbot living at the bottom right corner of the [documentation page](https://docs.vllm.ai/en/latest/), which can answer lots of frequently asked questions.","reactions":{"url":"https://api.github.com/repos/vllm-project/vllm/issues/49079/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vllm-project/vllm/issues/49079/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0}],"search_type":"lexical"}