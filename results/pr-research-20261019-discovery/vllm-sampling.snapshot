             pypi_0    pypi\n[conda] nvidia-cusolver           12.0.4.66                pypi_0    pypi\n[conda] nvidia-cusparse           12.6.3.3                 pypi_0    pypi\n[conda] nvidia-cusparselt-cu13    0.8.1                    pypi_0    pypi\n[conda] nvidia-cutlass-dsl        4.7.1                    pypi_0    pypi\n[conda] nvidia-cutlass-dsl-libs-base 4.7.1                    pypi_0    pypi\n[conda] nvidia-cutlass-dsl-libs-core 4.7.1                    pypi_0    pypi\n[conda] nvidia-cutlass-dsl-libs-cu12 4.7.1                    pypi_0    pypi\n[conda] nvidia-cutlass-dsl-libs-cu13 4.7.1                    pypi_0    pypi\n[conda] nvidia-ml-py              13.610.43                pypi_0    pypi\n[conda] nvidia-nccl-cu13          2.29.7                   pypi_0    pypi\n[conda] nvidia-nvjitlink          13.0.88                  pypi_0    pypi\n[conda] nvidia-nvshmem-cu13       3.4.5                    pypi_0    pypi\n[conda] nvidia-nvtx               13.0.85                  pypi_0    pypi\n[conda] nvidia-nvvm               13.2.78                  pypi_0    pypi\n[conda] optree                    0.19.1                   pypi_0    pypi\n[conda] pyzmq                     27.1.0                   pypi_0    pypi\n[conda] tokenspeed-triton         3.7.10.post20260531          pypi_0    pypi\n[conda] torch                     2.13.0+cu130             pypi_0    pypi\n[conda] torch-c-dlpack-ext        0.1.5                    pypi_0    pypi\n[conda] torchaudio                2.11.0                   pypi_0    pypi\n[conda] torchcodec                0.17.0                   pypi_0    pypi\n[conda] torchvision               0.28.0                   pypi_0    pypi\n[conda] transformers              5.17.0                   pypi_0    pypi\n[conda] triton                    3.7.1                    pypi_0    pypi\n\n==============================\n         vLLM Info\n==============================\nROCM Version                 : Could not collect\nvLLM Version                 : 0.31.0\nvLLM Build Flags:\n  CUDA Archs: Not Set; ROCm: Disabled; XPU: Disabled\nGPU Topology:\n  \t\u001B[4mGPU0\tGPU1\tGPU2\tGPU3\tGPU4\tGPU5\tGPU6\tGPU7\tCPU Affinity\tNUMA Affinity\tGPU NUMA ID\u001B[0m\nGPU0\t X \tNODE\tNODE\tNODE\tSYS\tSYS\tSYS\tSYS\t0-15,32-47\t0\t\tN/A\nGPU1\tNODE\t X \tNODE\tNODE\tSYS\tSYS\tSYS\tSYS\t0-15,32-47\t0\t\tN/A\nGPU2\tNODE\tNODE\t X \tNODE\tSYS\tSYS\tSYS\tSYS\t0-15,32-47\t0\t\tN/A\nGPU3\tNODE\tNODE\tNODE\t X \tSYS\tSYS\tSYS\tSYS\t0-15,32-47\t0\t\tN/A\nGPU4\tSYS\tSYS\tSYS\tSYS\t X \tNODE\tNODE\tNODE\t16-31,48-63\t1\t\tN/A\nGPU5\tSYS\tSYS\tSYS\tSYS\tNODE\t X \tNODE\tNODE\t16-31,48-63\t1\t\tN/A\nGPU6\tSYS\tSYS\tSYS\tSYS\tNODE\tNODE\t X \tNODE\t16-31,48-63\t1\t\tN/A\nGPU7\tSYS\tSYS\tSYS\tSYS\tNODE\tNODE\tNODE\t X \t16-31,48-63\t1\t\tN/A\n\nLegend:\n\n  X    = Self\n  SYS  = Connection traversing PCIe as well as the SMP interconnect between NUMA nodes (e.g., QPI/UPI)\n  NODE = Connection traversing PCIe as well as the interconnect between PCIe Host Bridges within a NUMA node\n  PHB  = Connection traversing PCIe as well as a PCIe Host Bridge (typically the CPU)\n  PXB  = Connection traversing multiple PCIe bridges (without traversing the PCIe Host Bridge)\n  PIX  = Connection traversing at most a single PCIe bridge\n  NV#  = Connection traversing a bonded set of # NVLinks\n\n==============================\n     Environment Variables\n==============================\nLD_LIBRARY_PATH=/data/zyzhao/anaconda3/envs/tcgp/lib/python3.12/site-packages/cv2/../../lib64:/opt/llvm-17/lib:/data/zyzhao/cuda/lib64:/opt/llvm-17/lib:/data/zyzhao/cuda/lib64:\nCUDA_HOME=/data/zyzhao/cuda\nCUDA_HOME=/data/zyzhao/cuda\nPYTORCH_NVML_BASED_CUDA_CHECK=1\nTORCHINDUCTOR_COMPILE_THREADS=1\nTORCHINDUCTOR_CACHE_DIR=/tmp/torchinductor_zyzhao\nVLLM_WORKER_MULTIPROC_METHOD=spawn\n```\n\n\n### 🐛 Describe the bug\n\n## Description\n\nWith `enable_lora=True`, setting `dtype=\"float32\"` (a documented, user-settable value) makes the engine die during the startup dummy forward, inside the LoRA expand Triton op:\n\n```\nAssertionError\n  File \".../vllm/lora/ops/triton_ops/lora_expand_op.py\", line 181, in _lora_expand\n    assert weight.dtype in [torch.float16, torch.bfloat16]\n```\n\nNothing validates the pair (`dtype=float32`, `enable_lora=True`) at config time; the incompatible combination is only discovered as a bare assertion inside a Triton kernel wrapper during `profile_run`, surfaced to the user as the opaque `RuntimeError: Engine core initialization failed`.\n\nThe assertion has no message, so the log does not state which dtype was received or that FP16/BF16 is required.\n\n## Steps to reproduce\n\n```python\nfrom vllm import LLM, SamplingParams\n\nllm = LLM(\n    model=\"LiquidAI/LFM2-8B-A1B\",\n    dtype=\"float32\",                # <-- triggers the bug\n    enable_lora=True,\n    max_model_len=4096,\n    seed=42,\n    gpu_memory_utilization=0.85,    # lower if your GPU is smaller\n)\nllm.generate([\"The capital of France is\"], SamplingParams(temperature=0.0, max_tokens=8))\n```\n\nControl: the same command with `dtype=\"float16\"` (LoRA still enabled) starts and generates normally.\n\n## Expected behavior\n\nEither the LoRA path supports float32 weights, or the combination is rejected cleanly at config-validation time, e.g.:\n\n```\nValueError: enable_lora=True requires dtype in {float16, bfloat16}; the LoRA Triton kernels\ndo not support float32 (got dtype=\"float32\").\n```\n\n## Actual behavior\n\nConfig accepted → `profile_run`/dummy forward → `lfm2_moe` forward → fused MoE LoRA path → `torch.ops.vllm.lora_expand.default` → `lora_expand_op.py:181` assert → EngineCore dies → client sees `RuntimeError: Engine core initialization failed`.\n\n## Environment\n\n- vLLM: 0.31.0 (official wheel)\n- PyTorch: 2.13.0+cu130, CUDA 13.0, driver 580.82.07\n- GPU: NVIDIA RTX 5880 Ada Generation (sm89), 47.4 GiB\n- OS: Ubuntu 22.04.4 LTS (glibc 2.35), Python 3.12.13\n- Model: `LiquidAI/LFM2-8B-A1B`\n\n## Full traceback (crash site, from EngineCore stderr)\n\n```text\nFile \".../vllm/v1/worker/gpu/model_runner.py\", line 861, in _dummy_run\n  self.execute_model(\nFile \".../vllm/v1/worker/gpu/model_runner.py\", line 2007, in execute_model\n  model_output = self.model(**model_inputs)\nFile \".../vllm/model_executor/models/lfm2_moe.py\", line 664, in forward\n  hidden_states = self.model(\nFile \".../vllm/compilation/decorators.py\", line 679, in __call__\n  output = self.aot_compiled_fn(self, *args, **kwargs)\n...\n    torch.ops.vllm.lora_expand.default(reinterpret_tensor(buf1, (1, s72, 16), (0, 16, 1), 0),\n                                       [arg7_1], buf0, ...)\nFile \".../vllm/lora/ops/triton_ops/lora_expand_op.py\", line 181, in _lora_expand\n  assert weight.dtype in [torch.float16, torch.bfloat16]\nAssertionError\n```\n\n## Additional context\n\n- Found by a config-interaction test generator; reproduced standalone with an explicit dtype control:\n\n  | config | outcome |\n  |---|---|\n  | `dtype=\"float32\"` + `enable_lora=True` | **AssertionError at `lora_expand_op.py:181`** (2/2 attempts) |\n  | `dtype=\"float16\"` + `enable_lora=True` | OK — engine starts, generates |\n\n  The only difference between the two rows is `dtype`, so the cause is isolated to the dtype × LoRA pair.\n- In the automated batch the same assertion appeared 4 times in a single point's stderr (retries), not 4 distinct configurations.\n- **Not a TF32 issue**: reproductions ran with `torch.set_float32_matmul_precision(\"highest\")`. The `TensorFloat32 tensor cores ... not enabled` warning that appears alongside is informational and is not the cause.\n- Related but distinct: the MoE fused-LoRA `max_lora_rank<=128` capacity assert is a separate constraint (rank axis) with its own report; both stem from LoRA backends whose preconditions are not reflected in config validation.\n\n\n### Before submitting a new issue...\n\n- [x] Make sure you already searched for relevant issues, and asked the chatbot living at the bottom right corner of the [documentation page](https://docs.vllm.ai/en/latest/), which can answer lots of frequently asked questions.","reactions":{"url":"https://api.github.com/repos/vllm-project/vllm/issues/61851/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vllm-project/vllm/issues/61851/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/vllm-project/vllm/issues/62308","repository_url":"https://api.github.com/repos/vllm-project/vllm","labels_url":"https://api.github.com/repos/vllm-project/vllm/issues/62308/labels{/name}","comments_url":"https://api.github.com/repos/vllm-project/vllm/issues/62308/comments","events_url":"https://api.github.com/repos/vllm-project/vllm/issues/62308/events","html_url":"https://github.com/vllm-project/vllm/issues/62308","id":5910129823,"node_id":"I_kwDOI7xefs8AAAABYEVsnw","number":62308,"title":"[Bug]: Qwen3.8-Flash-Next checkpoints with quantized q/k/v and an unquantized QSA indexer fail to load since #59533 (v0.32.0)","user":{"login":"srkim-business","id":137975233,"node_id":"U_kgDOCDlVwQ","avatar_url":"https://avatars.githubusercontent.com/u/137975233?v=4","gravatar_id":"","url":"https://api.github.com/users/srkim-business","html_url":"https://github.com/srkim-business","followers_url":"https://api.github.com/users/srkim-business/followers","following_url":"https://api.github.com/users/srkim-business/following{/other_user}","gists_url":"https://api.github.com/users/srkim-business/gists{/gist_id}","starred_url":"https://api.github.com/users/srkim-business/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/srkim-business/subscriptions","organizations_url":"https://api.github.com/users/srkim-business/orgs","repos_url":"https://api.github.com/users/srkim-business/repos","events_url":"https://api.github.com/users/srkim-busine