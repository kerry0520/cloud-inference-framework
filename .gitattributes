* text=auto
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
results/** -text
configs/** -text
# Unified diffs carry blank context lines as " " by format; raw logs may keep CR.
# Patches must round-trip byte-for-byte, so pin their line endings to LF.
patches/**/*.patch text eol=lf -whitespace
results/** -whitespace
